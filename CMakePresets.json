{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 x86",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/vs2022"
    },
    {
      "name": "vs2026-x86",
      "displayName": "Visual Studio 2026 x86",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/vs2026"
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x86",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x86",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x86",
      "configuration": "Release"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x86",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-debug",
      "configurePreset": "vs2022-x86",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026-x86",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022-x86",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026-x86",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
